<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IIITS-CSE CGPA Tracker</title>
  <link rel="stylesheet" href="../css/SignUp.css">
</head>
<body>
  <div class="container">
  <div class="left">
    <h1>Start Your Academic Journey</h1>
    <p>Track your IIITS-CSE CGPA, set goals, and monitor your progress with ease.</p>
    <img src="../images/signup.jpg" alt="">
  </div>

  <div class="right">
    <h1>Create Your Account</h1>
    <p>Unlock your academic potential.</p>
    <p style="color:red"><%= locals.msg%></p>
    <form action="/SignUp" method="post">
      <label for="RollNo">Roll Number</label>
      <input class="textbox" type="text" name="RollNo" placeholder="S202[2-7]00[1-3]0001" pattern="S202[2-7]00[1-3]0[0-9]{3}" title="Enter a valid Roll No (e.g., S20230010256)" required>
      <label for="name">Name</label>
      <input type="text" name="name" placeholder="Adam" required>

      <label for="email">Email</label>
<input type="text" name="email" placeholder="Adam@iiits.in" pattern="^[A-Za-z0-9._%+-]+@iiits[.]in$" title="Please enter a valid iiits.in email address" required>

      <label for="password">Password</label>
      <input type="password" name="password" placeholder="********" required>

      <label for="branch">Branch</label>
      <select name="branch" id="branch">
        <option value="CSE">CSE</option>
        <option value="ECE">ECE</option>
        <option value="AIDS">AIDS</option>
      </select>

      <button class="button">Sign Up</button>
      <a href="/">Already have an account? Log In</a>
    </form>
  </div>
</div>
</body>
</html>
